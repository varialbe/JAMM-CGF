<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jamm.Gui.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <SolidColorBrush x:Key="ToggleSwitchFillOn">#34C759</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#2DB64F</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#269C43</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOff">#8E8E93</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#7E7E83</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">White</SolidColorBrush>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">White</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOn"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
    <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14,8"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.7"/></Style>
    <Style Selector="Border.card"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/></Style>
  </Application.Styles>
</Application>
